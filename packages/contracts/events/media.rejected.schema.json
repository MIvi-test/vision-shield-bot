{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vision-shield-bot.example/events/media.rejected.schema.json",
  "title": "media.rejected",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "media.rejected"
    },
    "producer": {
      "const": "media-worker"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "media_profile_version",
        "worker_version",
        "reason_codes",
        "detected_format",
        "duration_ms"
      ],
      "properties": {
        "asset_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "media_profile_version": {
          "type": "string",
          "pattern": "^media-v[0-9]+$"
        },
        "worker_version": {
          "$ref": "common.schema.json#/$defs/version_tag"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/media_reason_code"
          }
        },
        "detected_format": {
          "enum": [
            "jpeg",
            "png",
            "webp",
            "gif",
            "heic",
            "tiff",
            "bmp",
            "unknown"
          ]
        },
        "duration_ms": {
          "$ref": "common.schema.json#/$defs/duration_ms"
        }
      },
      "description": "Технический отказ: файл невалиден или вне лимитов. Повтор не нужен, модератор не может одобрить."
    }
  }
}
