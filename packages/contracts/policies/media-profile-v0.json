{
  "media_profile_version": "media-v0",
  "input": {
    "formats": ["jpeg", "png", "webp"],
    "max_file_bytes": 10485760,
    "max_pixels": 25000000,
    "max_side_px": 8000,
    "min_side_px": 512,
    "max_frames": 1
  },
  "decode": {
    "timeout_ms": 5000,
    "max_memory_bytes": 536870912,
    "task_timeout_ms": 30000
  },
  "output": {
    "format": "jpeg",
    "quality": 85,
    "max_side_px": 2048,
    "color_mode": "RGB",
    "alpha": "flatten_white",
    "icc": "convert_to_srgb_and_drop",
    "apply_exif_orientation": true,
    "strip_metadata": true
  }
}
