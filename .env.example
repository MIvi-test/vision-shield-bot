# Configuration template for Sprint 1; services and Compose arrive in S1-03.
# Copy to .env. Use synthetic data locally; never commit real credentials.

# Backend MAX adapter: mock | polling | webhook
MAX_MODE=mock
# Internal Compose address; use http://localhost:8081 outside Compose.
MAX_API_BASE_URL=http://max-emulator:8080
# Fill only for a real test bot; leave empty in mock mode.
MAX_BOT_TOKEN=

# Local PostgreSQL; set a local password before starting the database.
POSTGRES_DB=vision_shield
POSTGRES_USER=vision_shield
POSTGRES_PASSWORD=
