# Configuration template for Sprint 1; services and Compose arrive in S1-03.
# Copy to .env. Use synthetic data locally; never commit real credentials.

# Backend bot currently supports mock only; polling/webhook are planned.
MAX_MODE=mock
# Internal Compose address; use http://localhost:8081 outside Compose.
MAX_API_BASE_URL=http://max-emulator:8080
# Fill only for a real test bot; leave empty in mock mode.
MAX_BOT_TOKEN=

# Emulator-only synthetic token; pass it to the SDK in mock mode.
# The standalone emulator reads exported environment variables, not .env.
MAX_EMULATOR_TOKEN=local-emulator-token

# Optional durable Backend bot. Use a local PostgreSQL SQLAlchemy URL;
# never commit the filled URL. Both processes read exported variables, not .env.
BACKEND_DATABASE_URL=
# Change after resetting emulator history; keep stable across bot restarts.
MAX_SOURCE_ID=mock-local
# Optional PostgreSQL integration tests; tests use isolated temporary schemas.
BACKEND_TEST_DATABASE_URL=

# Local PostgreSQL; set a local password before starting the database.
POSTGRES_DB=vision_shield
POSTGRES_USER=vision_shield
POSTGRES_PASSWORD=
