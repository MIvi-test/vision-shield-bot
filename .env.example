# Configuration template for the local Compose foundation (S1-03).
# Copy to .env. Use synthetic data locally; never commit real credentials.

# Backend bot currently supports mock only; polling/webhook are planned.
MAX_MODE=mock
# Internal Compose address; use http://localhost:8081 outside Compose.
MAX_API_BASE_URL=http://max-emulator:8080
# Fill only for a real test bot; leave empty in mock mode.
MAX_BOT_TOKEN=

# Emulator-only synthetic token; pass it to the SDK in mock mode.
# The standalone emulator reads exported environment variables, not .env.
MAX_EMULATOR_TOKEN=local-emulator-token

# Standalone Backend only. Compose constructs its internal URL from POSTGRES_*.
# Python processes read exported variables; Compose reads .env for interpolation.
BACKEND_DATABASE_URL=
# Empty: connectivity demo only. UUID from explicit manage.py campaign setup
# enables the Sprint 1 submission flow in run_inbox_bot.py.
BACKEND_CAMPAIGN_ID=
# Change after resetting emulator history; keep stable across bot restarts.
MAX_SOURCE_ID=mock-local
# Optional PostgreSQL integration tests; tests use isolated temporary schemas.
BACKEND_TEST_DATABASE_URL=

# Standalone only: set a credential-bearing AMQP URL locally, never commit it.
BACKEND_AMQP_URL=
# Standalone compatibility demo: direct; Compose always uses broker.
BACKEND_DELIVERY_MODE=direct

# Local PostgreSQL. Generate a URL-safe password with: openssl rand -hex 24
# Keep user/database names URL-safe too. Existing volumes retain old credentials.
POSTGRES_DB=vision_shield
POSTGRES_USER=vision_shield
POSTGRES_PASSWORD=

# S1-17: Compose uses RabbitMQ for reply delivery.
# Generate a separate password with: openssl rand -hex 24
RABBITMQ_USER=vision_shield
RABBITMQ_PASSWORD=

# HTTP services bind to host loopback only; DB/broker ports are not published.
BACKEND_PORT=8000
MAX_EMULATOR_PORT=8081
PANEL_PORT=8080
# Internal upstream for Caddy; the browser uses the panel's same-origin /api.
PANEL_BACKEND=backend:8000

# Exact browser origins (no wildcard). Missing Origin and Referer are rejected.
BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8000
# false only for this loopback-only HTTP Compose; true for HTTPS deployments.
BACKEND_COOKIE_SECURE=false
